generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  type      String
  date      DateTime @default(now())

  userId    Int
  user      User @relation(fields: [userId], references: [id])
}
model Budget {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  month     String
  userId    Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}